<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LocationManager.GPS_PROVIDER, never FusedLocationProviderClient - see
         SessionRecordingService's docs for why that distinction is load-bearing. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Corridor road-matching (fusion/CorridorFilter.kt) fetches the drivable OSM
         road network for the session's driving area from the public Overpass API
         (sensors/OverpassRoadNetworkProvider.kt) once per session, opportunistically,
         as soon as the first GNSS fix is available. Nothing else in this app touches
         the network - raw sensor/GNSS logging and the Stage 12 ONNX model (bundled
         as an asset) are both fully offline. A phone with no data connection simply
         never gets a road lock; corridor matching degrades to "not available this
         session" exactly like a missing/corrupt Stage 12 model does, never a crash. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground service so sensor delivery survives the screen turning off
         during a test drive. Android 14 (API 34) requires a declared type; this one
         is a location-tracking service by nature even though it also reads raw IMU,
         because "location" is the closest official type to "outdoor recording" and
         gives the OS the truthful signal for battery/background restrictions. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Requests the system settings screen that lets the user exempt this app
         from Doze/App Standby battery optimization. This is advisory, not
         required to record - the foreground service + partial wake lock already
         keep sampling alive on stock Android - but several OEM skins (MIUI and
         similar) apply additional throttling on top of stock Doze that only this
         exemption reliably lifts. See MainActivity's BatteryOptimizationBanner. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Raw accelerometer, gyroscope and magnetometer. No android.hardware.sensor.*
         <uses-feature> requirement is declared: a device missing one of these can
         still install the app and get a clear in-app error, rather than being
         silently excluded from the Play listing on a hackathon demo device that
         might be borrowed. -->

    <application
        android:name=".DeadReckoningApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DeadReckoning">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sensors.SessionRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/session_paths" />
        </provider>

    </application>

</manifest>
